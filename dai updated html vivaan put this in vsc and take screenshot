<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MUN Portal | Global Diplomacy Platform</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #1a1f36;
            --secondary: #252c4d;
            --accent: #5c6bc0;
            --accent-light: #7986cb;
            --text: #eef2ff;
            --text-secondary: #c5cae9;
            --border: rgba(92, 107, 192, 0.2);
            --success: #66bb6a;
            --space-dark: #0a0c1c;
            --nebula-purple: #6a4c93;
            --star-yellow: #ffd700;
            --gold: #ffc107;
        }

        body {
            background: linear-gradient(rgba(10, 12, 28, 0.95), rgba(15, 18, 40, 0.98)), 
                        url('https://i.postimg.cc/s2nkF0dR/IMG-20250614-WA0052.jpg') no-repeat center center fixed;
            background-size: cover;
            color: var(--text);
            font-family: 'Montserrat', sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            line-height: 1.6;
            transition: background 0.8s ease;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        header {
            padding: 30px 0;
            position: relative;
            z-index: 100;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            display: flex;
            align-items: center;
        }

        .logo-icon {
            font-size: 32px;
            color: var(--accent-light);
            margin-right: 15px;
        }

        .logo-text {
            font-family: 'Orbitron', sans-serif;
            font-weight: 600;
            font-size: 28px;
            letter-spacing: 1px;
        }

        .logo-text span {
            color: var(--accent-light);
        }

        nav ul {
            display: flex;
            list-style: none;
        }

        nav li {
            margin-left: 30px;
        }

        nav a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            transition: color 0.3s ease;
            position: relative;
        }

        nav a:after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent-light);
            transition: width 0.3s ease;
        }

        nav a:hover {
            color: var(--text);
        }

        nav a:hover:after {
            width: 100%;
        }

        /* Page Sections */
        .page {
            display: none;
            padding-bottom: 50px;
        }

        .page.active {
            display: block;
        }

        .hero {
            text-align: center;
            padding: 80px 0 60px;
            max-width: 900px;
            margin: 0 auto;
            animation: fadeIn 1.5s ease-out;
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 52px;
            font-weight: 600;
            margin-bottom: 20px;
            letter-spacing: 1px;
            text-shadow: 0 5px 15px rgba(0, 0, 0, 0.7);
        }

        .hero h1 span {
            position: relative;
        }

        .hero h1 span::after {
            content: '';
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 70%;
            height: 4px;
        }

        .hero p {
            font-size: 22px;
            color: var(--text-secondary);
            margin-bottom: 40px;
            line-height: 1.8;
            max-width: 700px;
            margin: 0 auto 40px;
        }

        .stats {
            display: flex;
            justify-content: center;
            gap: 50px;
            margin-top: 50px;
            animation: slideUp 1s ease-out;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 42px;
            font-weight: 600;
            font-family: 'Orbitron', sans-serif;
            color: var(--accent-light);
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 16px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-container {
            display: flex;
            justify-content: center;
            gap: 60px;
            margin-top: 80px;
            animation: slideUp 1s ease-out;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            transition: transform 0.3s ease;
            width: 180px;
        }

        .nav-item:hover {
            transform: translateY(-10px);
        }

        .icon-wrapper {
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 25px;
            backdrop-filter: blur(10px);
            border: 2px solid var(--border);
            transition: all 0.3s ease;
        }

        .nav-item:hover .icon-wrapper {
            background: rgba(255, 255, 255, 0.2);
            transform: scale(1.1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .nav-icon {
            font-size: 50px;
            color: var(--text);
        }

        .nav-text {
            color: var(--text);
            font-size: 1.8rem;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        /* Google Form Section */
        .google-form-section {
            background: var(--primary);
            border-radius: 12px;
            padding: 50px;
            margin: 40px auto;
            border: 1px solid var(--border);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            max-width: 900px;
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.8s ease-out;
            text-align: center;
        }

        .google-form-section:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent-light));
        }

        .form-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .form-header h2 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--text);
        }

        .form-header p {
            color: var(--text-secondary);
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

        .btn-container {
            text-align: center;
            margin-top: 30px;
        }

        .payment-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--accent);
            color: white;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            padding: 16px 45px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(92, 107, 192, 0.3);
        }

        .payment-btn:hover {
            background: var(--accent-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(92, 107, 192, 0.4);
        }

        .payment-btn i {
            margin-left: 10px;
            transition: transform 0.3s ease;
        }

        .payment-btn:hover i {
            transform: translateX(5px);
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--text);
            border: 1px solid var(--border);
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            padding: 14px 30px;
            border-radius: 8px;
            margin-top: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent-light);
        }

        .back-btn i {
            margin-right: 10px;
            transition: transform 0.3s ease;
        }

        .back-btn:hover i {
            transform: translateX(-5px);
        }

        /* Features Section */
        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin: 80px 0;
        }

        .feature-card {
            background: var(--primary);
            border-radius: 12px;
            padding: 35px 30px;
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            text-align: center;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }

        .feature-icon {
            font-size: 42px;
            color: var(--accent-light);
            margin-bottom: 25px;
        }

        .feature-card h3 {
            font-size: 20px;
            margin-bottom: 15px;
            color: var(--text);
        }

        .feature-card p {
            color: var(--text-secondary);
            font-size: 15px;
        }

        /* Committees & Resources Styles */
        .committees-page, .resources-page, .about-page {
            background: 
                linear-gradient(rgba(10, 12, 28, 0.92), rgba(15, 18, 40, 0.95)), 
                url('https://i.postimg.cc/ZKX6Nt90/IMG-20250614-WA0051.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        .committees-container {
            display: flex;
            gap: 30px;
            margin: 40px 0 80px;
        }

        .committee-list {
            flex: 1;
            background: rgba(25, 30, 60, 0.7);
            border-radius: 12px;
            border: 1px solid var(--border);
            padding: 20px;
            max-height: 800px;
            overflow-y: auto;
            position: sticky;
            top: 20px;
        }

        .committee-list h2 {
            text-align: center;
            margin-bottom: 25px;
            color: var(--accent-light);
            font-size: 24px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border);
        }

        .committee-item {
            padding: 15px;
            margin-bottom: 15px;
            background: rgba(41, 47, 85, 0.5);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }

        .committee-item:hover {
            background: rgba(41, 47, 85, 0.8);
            transform: translateX(5px);
        }

        .committee-item.active {
            background: rgba(92, 107, 192, 0.2);
            border-left: 4px solid var(--accent-light);
        }

        .committee-item h3 {
            font-size: 18px;
            margin-bottom: 5px;
            color: var(--text);
        }

        .committee-item p {
            font-size: 14px;
            color: var(--text-secondary);
        }

        .agenda-details {
            flex: 2;
            background: rgba(25, 30, 60, 0.7);
            border-radius: 12px;
            border: 1px solid var(--border);
            padding: 30px;
            min-height: 600px;
        }

        .agenda-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .agenda-header h2 {
            font-size: 28px;
            color: var(--text);
            margin-bottom: 10px;
        }

        .agenda-header p {
            color: var(--text-secondary);
            font-size: 16px;
            max-width: 700px;
            margin: 0 auto;
        }

        .agenda-section, .guide-section {
            margin-bottom: 30px;
        }

        .agenda-section h3, .guide-section h3 {
            font-size: 20px;
            margin-bottom: 15px;
            color: var(--accent-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .agenda-section h3 i, .guide-section h3 i {
            color: var(--star-yellow);
        }

        .agenda-topics {
            list-style: none;
            margin-left: 15px;
        }

        .agenda-topics li {
            padding: 8px 0;
            position: relative;
            padding-left: 25px;
        }

        .agenda-topics li:before {
            content: '•';
            position: absolute;
            left: 0;
            color: var(--star-yellow);
            font-size: 20px;
        }

        .agenda-schedule {
            margin-top: 20px;
        }

        .schedule-item {
            display: flex;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px dashed var(--border);
        }

        .schedule-time {
            width: 100px;
            font-weight: 600;
            color: var(--star-yellow);
        }

        .schedule-desc {
            flex: 1;
        }

        .guide-content p {
            margin-bottom: 15px;
            line-height: 1.7;
        }

        .download-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--nebula-purple);
            color: white;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 20px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

        .download-btn:hover {
            background: #5d3d7e;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }

        .download-btn i {
            margin-right: 8px;
        }

        /* Resources Section */
        .resources-container {
            display: flex;
            gap: 30px;
            margin: 40px 0 80px;
        }

        .resource-details {
            flex: 2;
            background: rgba(25, 30, 60, 0.7);
            border-radius: 12px;
            border: 1px solid var(--border);
            padding: 30px;
            min-height: 600px;
        }

        .resource-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .resource-header h2 {
            font-size: 28px;
            color: var(--text);
            margin-bottom: 10px;
        }

        .resource-header p {
            color: var(--text-secondary);
            font-size: 16px;
            max-width: 700px;
            margin: 0 auto;
        }

        .resource-section {
            margin-bottom: 30px;
        }

        .resource-section h3 {
            font-size: 20px;
            margin-bottom: 15px;
            color: var(--accent-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .resource-section h3 i {
            color: var(--star-yellow);
        }

        .resource-links {
            list-style: none;
        }

        .resource-links li {
            padding: 12px 0;
            position: relative;
            padding-left: 25px;
            border-bottom: 1px dashed var(--border);
        }

        .resource-links li:last-child {
            border-bottom: none;
        }

        .resource-links li:before {
            content: '→';
            position: absolute;
            left: 0;
            color: var(--star-yellow);
        }

        .resource-links a {
            color: var(--text);
            text-decoration: none;
            transition: color 0.3s;
            display: block;
            font-size: 16px;
        }

        .resource-links a:hover {
            color: var(--accent-light);
            text-decoration: underline;
        }

        .resource-links .desc {
            display: block;
            font-size: 14px;
            color: var(--text-secondary);
            margin-top: 5px;
        }

        /* About Page Styles */
        .about-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .about-section {
            background: rgba(25, 30, 60, 0.7);
            border-radius: 12px;
            padding: 40px;
            margin-bottom: 40px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .about-section h2 {
            font-size: 32px;
            color: var(--accent-light);
            margin-bottom: 25px;
            text-align: center;
            position: relative;
            padding-bottom: 15px;
        }

        .about-section h2:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: var(--accent);
        }

        .about-section h3 {
            font-size: 22px;
            color: var(--star-yellow);
            margin: 30px 0 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .about-section h3 i {
            font-size: 26px;
        }

        .about-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        .about-card {
            background: rgba(41, 47, 85, 0.5);
            border-radius: 10px;
            padding: 25px;
            border: 1px solid var(--border);
            transition: all 0.3s ease;
        }

        .about-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .about-card h4 {
            font-size: 20px;
            color: var(--text);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .about-card h4 i {
            color: var(--accent-light);
        }

        .about-card p {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.7;
        }

        .rules-list {
            list-style: none;
            padding-left: 20px;
        }

        .rules-list li {
            padding: 12px 0;
            position: relative;
            padding-left: 30px;
        }

        .rules-list li:before {
            content: '•';
            position: absolute;
            left: 0;
            color: var(--accent-light);
            font-size: 24px;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .team-member {
            text-align: center;
            padding: 25px;
            background: rgba(41, 47, 85, 0.5);
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        .team-photo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            margin: 0 auto 20px;
            background: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            color: var(--accent-light);
        }

        .team-member h4 {
            font-size: 20px;
            color: var(--text);
            margin-bottom: 5px;
        }

        .team-member .role {
            color: var(--accent-light);
            font-weight: 500;
            margin-bottom: 15px;
        }

        .testimonials-container {
            display: flex;
            gap: 30px;
            margin-top: 30px;
        }

        .testimonial {
            flex: 1;
            background: rgba(41, 47, 85, 0.5);
            border-radius: 10px;
            padding: 30px;
            border: 1px solid var(--border);
            position: relative;
        }

        .testimonial:before {
            content: '"';
            position: absolute;
            top: 20px;
            left: 20px;
            font-size: 80px;
            color: var(--accent-light);
            opacity: 0.2;
            font-family: serif;
            line-height: 1;
        }

        .testimonial p {
            font-style: italic;
            color: var(--text-secondary);
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .testimonial .author {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .author-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .author-info h5 {
            color: var(--text);
            font-size: 18px;
        }

        .author-info .position {
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* Stars */
        .stars {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: twinkle var(--duration, 5s) infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; }
            50% { opacity: 1; }
        }

        footer {
            background: var(--primary);
            padding: 60px 0 30px;
            border-top: 1px solid var(--border);
            margin-top: 80px;
            position: relative;
            z-index: 10;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-column h4 {
            font-size: 18px;
            margin-bottom: 20px;
            color: var(--text);
            position: relative;
            padding-bottom: 10px;
        }

        .footer-column h4:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 2px;
            background: var(--accent-light);
        }

        .footer-column ul {
            list-style: none;
        }

        .footer-column li {
            margin-bottom: 12px;
        }

        .footer-column a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s ease;
            font-size: 15px;
        }

        .footer-column a:hover {
            color: var(--accent-light);
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid var(--border);
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Background pattern */
        .bg-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 10% 20%, rgba(41, 128, 185, 0.05) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(41, 128, 185, 0.05) 0%, transparent 20%);
            pointer-events: none;
            z-index: 0;
            animation: rotateBackground 60s linear infinite;
        }

        @keyframes rotateBackground {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Responsive adjustments */
        @media (max-width: 900px) {
            .features {
                grid-template-columns: 1fr;
            }
            
            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .nav-container {
                gap: 40px;
